{
  "name": "flexible-workbench",
	"version": "2.2.0",
  "description": "A personal, flexible Obsidian dashboard and workbench.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/callmejack96/flexible-workbench.git"
  },
  "bugs": {
    "url": "https://github.com/callmejack96/flexible-workbench/issues"
  },
  "homepage": "https://github.com/callmejack96/flexible-workbench#readme",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"lint": "eslint src test",
		"lint:fix": "eslint src test --fix",
		"import:source-sync": "node scripts/import-multi-source-sync.mjs",
		"test": "vitest run",
		"verify:manifests": "node scripts/verify-manifests.mjs"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"dashboard",
		"home",
		"launcher"
	],
	"author": "callmejack96",
	"license": "MIT",
	"devDependencies": {
		"@stratejya/operon-cli": "^1.2.0",
		"@types/node": "^26.6.5",
		"esbuild": "^0.28.2",
		"eslint": "^10.12.0",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"moment": "2.31.0",
		"obsidian": "latest",
		"tslib": "^2.6.2",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.63.0",
		"vitest": "^5.0.4"
	}
}
